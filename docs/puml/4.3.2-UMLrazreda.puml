@startuml Reprezentativni_UML_Dijagram_Razreda

skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF

' --- RAZREDI ---

class Korisnik {
  - uuid: String
  - uloga: Uloga
  - ime: String
  - prezime: String
  - email: String
  - telefon: String
}

class korisnikIzmjena {
  - telefon: String
  - ime: String
  - prezime: String
  - uloga: Uloga
}

class Rezervacija <<planirano>> {
  - idRezervacije: int
  - datumPreuzimanja: Date
  - datumPovratka: Date
  - brojOsoba: int
  - vrijemeNastanak: DateTime
  - cijenaUk: decimal
  - status: StatusRezervacije
  + kreirajRezervaciju(): boolean
  + izmijeniRezervaciju(): boolean
  + izracunajUkupnuCijenu(): decimal
  + otkaziRezervaciju(): void
}

class Brod <<planirano>> {
  - idBrod: int
  - naziv: String
  - godinaProizvodnje: int
  - cijenaDan: decimal
  - vrijemePreuzimanja: Time
  - vrijemePovratka: Time
  - aktivan: boolean
  + provjeriDostupnost(od: Date, do: Date): boolean
}

class Model <<planirano>> {
  - idModel: int
  - tip: String
  - kategorija: String
  - proizvodjac: String
  - model: String
  - kapacitet: int
  - brojKabina: int
  - brojLezajeva: int
}

class Luka <<planirano>> {
  - idLuka: int
  - imeLuka: String
  - lat: decimal
  - lng: decimal
}

class DodatnaUsluga <<planirano>> {
  - idDodatneUsluge: int
  - naziv: String
}

class UslugaModela <<planirano>> {
  - cijena: decimal
}


enum Uloga {
  klijent
  admin
  djelatnik
  voditelj
}

enum StatusRezervacije <<planirano>> {
  u_tijeku
  potvrdena
  otkazana
}

' --- VEZE (ASOCIJACIJE) ---

Korisnik "1" -- "0..*" Rezervacija : izradjuje >
Rezervacija "0..*" -- "1" Brod : odnosi se na >
Rezervacija "0..*" -- "1" Luka : mjesto preuzimanja >
Rezervacija "0..*" -- "0..*" DodatnaUsluga : sadrzi >
Brod "0..*" -- "1" Model : primjerak je >
Brod "0..*" -- "1" Luka : maticna luka >
Model "0..*" -- "0..*" DodatnaUsluga : nudi >
(Model, DodatnaUsluga) .. UslugaModela
Korisnik ..> Uloga : može biti >
korisnikIzmjena ..> Uloga : koristi >
Rezervacija ..> StatusRezervacije : koristi >

@enduml
