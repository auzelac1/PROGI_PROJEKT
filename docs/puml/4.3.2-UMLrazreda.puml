@startuml Reprezentativni_UML_Dijagram_Razreda

skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF

' --- RAZREDI ---

class Korisnik {
  - uuid: String
  - uloga: UlogaKorisnika
  - ime: String
  - prezime: String
  - email: String
  - telefon: String
  + prijaviSe(): boolean
}

class Rezervacija {
  - idRezervacije: int
  - datumPreuzimanja: Date
  - datumPovratka: Date
  - brojOsoba: int
  - vrijemeNastanak: DateTime
  - cijenaUk: decimal
  - status: StatusRezervacije
  + kreirajRezervaciju(): boolean
  + izracunajUkupnuCijenu(): decimal
  + otkaziRezervaciju(): void
}

class Brod {
  - idBrod: int
  - naziv: String
  - godinaProizvodnje: int
  - cijenaDan: decimal
  - vrijemePreuzimanja: Time
  - vrijemePovratka: Time
  - aktivan: boolean
  + provjeriDostupnost(od: Date, do: Date): boolean
}

class Model {
  - idModel: int
  - tip: String
  - kategorija: String
  - proizvodjac: String
  - model: String
  - kapacitet: int
  - brojKabina: int
  - brojLezajeva: int
}

class Luka {
  - idLuka: int
  - imeLuka: String
  - lat: decimal
  - lng: decimal
}

class DodatnaUsluga {
  - idDodatneUsluge: int
  - naziv: String
}

class UslugaModela {
  - cijena: decimal
}


enum UlogaKorisnika {
  KLIJENT
  ADMIN
  DJELATNIK
  VODITELJ
}

enum StatusRezervacije {
  U_TIJEKU
  POTVRDENA
  OTKAZANA
}

' --- VEZE (ASOCIJACIJE) ---

Korisnik "1" -- "0..*" Rezervacija : izradjuje >
Rezervacija "0..*" -- "1" Brod : odnosi se na >
Rezervacija "0..*" -- "1" Luka : mjesto preuzimanja >
Rezervacija "0..*" -- "0..*" DodatnaUsluga : sadrzi >
Brod "0..*" -- "1" Model : primjerak je >
Brod "0..*" -- "1" Luka : maticna luka >
Model "0..*" -- "0..*" DodatnaUsluga : nudi >
(Model, DodatnaUsluga) .. UslugaModela
Korisnik ..> UlogaKorisnika : koristi >
Rezervacija ..> StatusRezervacije : koristi >

@enduml
