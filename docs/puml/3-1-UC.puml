@startuml
left to right direction
title "Charter poslovanje - Dijagram obrazaca uporabe"

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529
skinparam FontColor #748cab

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' Primarni akteri

actor Neprijavljeni as "Neprijavljeni korisnik"
actor Klijent as "Klijent"
actor Djelatnik as "Djelatnik"
actor Voditelj as "Voditelj"
actor Admin as "Administrator"

' Sekundarni akteri
actor "Vanjski pružatelj identiteta" as idp <<external system>>
actor "Meteorološki servis" as meteo <<external system>>
actor "Kartografski servis" as map <<external system>>

' Specijalizacije
Klijent -|> Neprijavljeni
Admin -|> Djelatnik
Djelatnik -|> Neprijavljeni
Voditelj -|> Neprijavljeni

' Raspored na dijagramu
Neprijavljeni-[hidden]down-> Klijent
Djelatnik -[hidden]down-> Klijent
Djelatnik -[hidden]down-> Voditelj
Admin -[hidden]down-> Djelatnik

rectangle "Charter poslovanje" as Charter {

    ' Izrada rezervacije
    (UC-001:\nIzrada rezervacije) as izradaRezervacije
    
    ' Uređivanje i otkazivanje rezervacija
    (UC-002:\nPregled svih rezervacija) as pregledRezervacije
    (UC-003:\nOtkazivanje rezervacije) as otkazivanjeRezervacije
    (UC-004:\nUređivanje rezervacije) as uredjivanjeRezervacije

    ' Evidentiranje razdoblja nedostupnosti plovila
    (UC-005:\nEvidentiranje razdoblja nedostupnosti plovila) as nedostupnost
    
    ' Pregled rasporeda preuzimanja i povrata
    (UC-006:\nPregled rasporeda preuzimanja i povrata) as preuzimanjePovrat

    ' Pretraga i pregled plovila
    (UC-007:\nPretraga i pregled plovila) as pregledPlovila

    ' Upravljanje plovilima i dodatnim uslugama
    (UC-008:\nUpravljanje plovilima i dodatnim uslugama) as upravljanjePlovilima
    together {
        ' Statistika i izvoz
        (UC-009:\nStatistika i izvoz) as statistika

        ' Prijava korisnika
        (UC-010:\nPrijava korisnika) as prijava
    }
}

' Asocijacije aktera i slučajeva uporabe
Klijent -- izradaRezervacije

Admin -- pregledRezervacije

Admin -- otkazivanjeRezervacije

Admin -- uredjivanjeRezervacije

Admin -- nedostupnost

Djelatnik -- preuzimanjePovrat

Neprijavljeni -- pregledPlovila

Neprijavljeni -- pregledPlovila

Admin -- upravljanjePlovilima

Voditelj -- statistika

Neprijavljeni -- prijava

' Slanje poruke klijentu da mu je rezervacija otkazana
otkazivanjeRezervacije --> Klijent

' Obavezno ponašanje
otkazivanjeRezervacije ..> pregledRezervacije : <<include>>
uredjivanjeRezervacije ..> pregledRezervacije : <<include>>

' Opcionalno ponašanje
izradaRezervacije ..> pregledPlovila : <<extend>>\n[odabrana izrada rezervacije]

' Interakcije sa sekundarnim akterima
pregledPlovila -- meteo
pregledPlovila -- map
prijava -- idp

meteo -[hidden]left-> map
idp -[hidden]down-> meteo


@enduml
